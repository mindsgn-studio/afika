{
  "expo": {
    "name": "AFIKA",
    "slug": "afika",
    "version": "0.2.41",
    "scheme": "afika",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/afika.icon",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "bundleIdentifier": "mindsgn.studio.pockt",
      "appleTeamId": "B3U8UM2966",
      "buildNumber": "47",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your Camera to scan wallet addresses",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "../../GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "mindsgn.studio.pockt",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "../../google-services.json",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-localization",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"],
            "minSdkVersion": 34,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.gemalto.jp2.**\n-dontwarn com.tom_roush.pdfbox.filter.JPXFilter\n# JNA 5.17.0 Android AAR: Native.getWindowHandle0(java.awt.Component) is a desktop entry point. Spark UniFFI only calls Native.load.\n-dontwarn java.awt.Component"
          },
          "ios": {
            "useFrameworks": "static",
            "usePrecompiledModules": false,
            "enableSceneSupport": true,
            "forceStaticLinking": [
              "RNFBAnalytics",
              "RNFBApp",
              "RNFBAppCheck",
              "RNFBAuth",
              "RNFBCrashlytics",
              "RNFBMessaging",
              "RNFBRemoteConfig",
              "RNFBStorage"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      "expo-background-task",
      "./plugins/withGrpcSwiftModuleFix.js",
      "./plugins/withAndroidReleaseNodeEnv.js",
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "privyAppId": "cmuqob0zx011s0cjqgmza7ovk",
      "privyClientId": "client-WY6dzubtPqBKGnPj2TUbUok8KRXN626SLDxiq31kbrbm3",
      "eas": {
        "projectId": "595f11ae-2cb9-48f8-b628-6ef59937e3e2"
      }
    }
  }
}
